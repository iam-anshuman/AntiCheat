# HTTPS address reachable by both laptop and phone (same Wi-Fi for a local pilot).
# PUBLIC_BASE_URL=https://192.168.1.10:3443
PORT=3443
# Set once at first startup. Otherwise a random password is saved in .data/admin-password.
# ADMIN_PASSWORD=choose-a-long-private-password
# For a trusted certificate, provide both paths. Otherwise a local development cert is generated.
# TLS_CERT_PATH=C:/certificates/fullchain.pem
# TLS_KEY_PATH=C:/certificates/privkey.pem
# For interviews across different networks, configure your own authenticated TURN service.
# ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"password"}]
# NODE_ENV=production
